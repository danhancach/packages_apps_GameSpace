<!-- Anatomy Expressive: root minHeight 72dp, pad ngang 16dp, pad doc 0; text frame pad doc 16dp; icon frame 40dp + marginEnd 12dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/gamespace_preference_row_min_height"
    android:layout_marginHorizontal="@dimen/gamespace_preference_card_margin_horizontal"
    android:layout_marginBottom="@dimen/gamespace_preference_card_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gamespace_preference_row_padding_start"
    android:paddingEnd="@dimen/gamespace_preference_row_padding_end"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="@dimen/gamespace_preference_icon_size"
        android:layout_height="@dimen/gamespace_preference_icon_size"
        android:layout_marginEnd="@dimen/gamespace_preference_icon_margin_end"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/widget_frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/gamespace_preference_row_padding_vertical"
        android:paddingBottom="@dimen/gamespace_preference_row_padding_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/gamespace_preference_icon_margin_end">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <ImageView
        android:id="@+id/launch_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/gamespace_preference_icon_margin_end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/launch_game"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />

    <ImageView
        android:id="@+id/settings_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/per_app_title"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_gear" />

</LinearLayout>
