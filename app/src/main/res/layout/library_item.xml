<!--
     LSPosed selection row: full-card 2/1 hit (KHONG pad 16dp tren root).
     Insets nam trong child: launch_zone padStart, trigger padEnd.
     Mode label truoc glyph; Miuix ArrowUpDown 10x16 + gap 8dp, no auto-mirror.
     Gap doc giua card: SettingsBasePreferenceFragment.MarginItemDecoration
     (settingslib_expressive_space_extrasmall1=2dp) — khong layout_marginBottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/gamespace_preference_row_min_height"
    android:layout_marginHorizontal="@dimen/gamespace_preference_card_margin_horizontal"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- 2/3 full-card: icon + title — Preference click / launch -->
    <LinearLayout
        android:id="@+id/launch_zone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gamespace_preference_row_padding_start"
        android:paddingTop="@dimen/gamespace_preference_row_padding_vertical"
        android:paddingBottom="@dimen/gamespace_preference_row_padding_vertical">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/gamespace_preference_icon_size"
            android:layout_height="@dimen/gamespace_preference_icon_size"
            android:layout_marginEnd="@dimen/gamespace_preference_icon_margin_end"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <!-- 1/3 full-card: mode truoc glyph — mo popup (khong launch); full-height touch -->
    <!-- value→caret gap 8dp = Miuix SuperDropdown paddingEnd (ch0/bb2 d34.x end=8) -->
    <LinearLayout
        android:id="@+id/mode_popup_trigger"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/gamespace_preference_row_padding_end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/per_app_mode_title">

        <!-- weight 1 + 0dp: khong de wrap/maxWidth120 cuop cho glyph -->
        <TextView
            android:id="@android:id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageView
            android:id="@+id/mode_chevrons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_library_mode_chevrons"
            android:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
